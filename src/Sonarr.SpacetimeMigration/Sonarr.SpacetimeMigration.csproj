<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net10.0</TargetFrameworks>
    <Nullable>disable</Nullable>
    <RootNamespace>Sonarr.SpacetimeMigration</RootNamespace>
    <!-- SA1200 fires on using-outside-namespace in vendored files; suppress the same as the main solution -->
    <NoWarn>$(NoWarn);CS1591;SA1200</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\NzbDrone.Core\Sonarr.Core.csproj" />
  </ItemGroup>
  <!-- SQLite + Dapper: needed only by the vendored SQL-reading layer, not the main app -->
  <ItemGroup>
    <PackageReference Include="System.Data.SQLite.Core" Version="1.0.119" />
    <PackageReference Include="Dapper" Version="2.1.35" />
    <PackageReference Include="Polly" Version="8.7.0" />
  </ItemGroup>
</Project>
